{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="syco-services-section section-{{ section.id }}-padding">
  <div class="page-width">
  <h2>{{ section.settings.heading }}</h2>
  <div class="services-grid">
    {% for block in section.blocks %}
  {% case block.type %}
    {% when 'view_all_card' %}
      <div class="service-card view-all-card">
        <div class="view-all-inner">
          <h3>{{ block.settings.card_heading }}</h3>
          <a href="{{ block.settings.btn_url }}" class="service-button">{{ block.settings.btn_label }}</a>
        </div>
      </div>
    {% when 'service_card' %}
      <div class="service-card">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.title }}" class="service-image">
        {% endif %}
        <div class="service-content">
          <h3>{{ block.settings.title }}</h3>
          <div class="s-rich">{{ block.settings.rich }}</div>
          <a href="{{ block.settings.btn_url }}" class="service-button">{{ block.settings.btn_label }}</a>
        </div>
      </div>
  {% endcase %}
{% endfor %}

  </div>
  </div>
</section>

<style>
.services-section {
  text-align: center;
  padding: 50px 20px;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
  justify-content: center;
}

.service-card {
  position: relative;
  height: 450px; 
  overflow: hidden;
}

.service-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius:20px;
}

.service-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5); 
  display:block !important;
}

.service-content {
  position: relative;
  bottom: 35px;
  left: 20px;
  right: 20px;
  color: white;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  text-align:left;
  height:80%;
  gap: 10px;
}

.service-content h3 {
    font-size: 30px;
    font-weight: 600;
    color: #fff;
    margin: 0;
}

  .service-content h3 {
    position: absolute;
    z-index: 2;
    transform-origin: top left;
    mix-blend-mode: difference !important;
    color: rgb(255, 255, 255) !important;
    transform: translate(120%, 10px) rotate(-90deg);
    text-align: left !important;
}
  
.s-rich {
    font-size: 16px;
}
  
.s-rich p {
    margin:0;
}

  .syco-services-section h2 {
    font-size: 35px;
    font-weight: 600;
}

.service-button {
    background: #332C27;
    color: #fff;
    text-align: center;
    padding: 7px 40px;
    text-decoration: none;
    font-weight: 500;
    font-size: 16px;
    display: inline-flex;
    width: fit-content;
    text-align: center;
    align-items: center;
    justify-content: center;
    line-height: 24px;
  border-radius:50px;
}
  .view-all-card {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #938e88;
  color: #000;
  text-align: center;
  border-radius:20px;
}

.view-all-inner {
  padding: 30px 20px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  align-items: center;
}

.view-all-card h3 {
  font-size: 24px;
  font-weight: 600;
  margin: 0;
  color: #1c1c1c;
}

</style>

{% schema %}
{
  "name": "Services cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Services"
    },
    {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Padding Top",
          "default": 40
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Padding Bottom",
          "default": 52
        }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Service Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Service Title"
        },
        {
          "type": "richtext",
          "id": "rich",
          "label": "Services List"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button URL"
        }
      ]
    },
    {
  "type": "view_all_card",
  "name": "View All Card",
  "settings": [
    {
      "type": "text",
      "id": "card_heading",
      "label": "Heading",
      "default": "Trending Wellness Programs"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL",
      "default": "/collections/all"
    }
  ]
}

  ],
  "presets": [
    {
      "name": "Services cards"
    }
  ]
}
{% endschema %}