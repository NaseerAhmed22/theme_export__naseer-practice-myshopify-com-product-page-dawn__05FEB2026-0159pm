{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="cus_imtg_with_text section-{{ section.id }}-padding"
  style="background-image:url({{ section.settings.bg_img | img_url:"master" }})"
>
  <div class="page-width">
    <div class="cus_img_grid">
      <div class="left_col">
        <div class="inner_content">
          <h2>{{ section.settings.heading }}</h2>
          <div class="inner_description">{{ section.settings.inner_rich }}</div>
          {% if section.settings.btn_label != blank %}
            <a href="{{ section.settings.url }}" class="cus_btn">{{ section.settings.btn_label }}</a>
          {% endif %}
          <p class="happy_customer">{{ section.settings.happy_customer }}</p>
        </div>
      </div>
      <div class="right_col">
        <div class="cus_img">
          {% if section.settings.img != blank %}
            <img src="{{ section.settings.img  | img_url:"master" }}" alt="Image">
          {% endif %}
        </div>
      </div>
    </div>
    {% comment %} reviews {% endcomment %}
    <div class="cus_reviews">
      {% for block in section.blocks %}
        <div class="review_col">
          <div class="reviews_content">{{ block.settings.reviews_rich }}</div>
          <div class="reviews_rating">
            {% render 'reviews_rating' %}
            {% render 'reviews_ux_svg' %}
            <p>{{ block.settings.author }}</p>
            {% render 'reviews_ux_svg' %}
            <p class="reviews_date">{{ block.settings.review_date }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
<style>
      .cus_imtg_with_text{
      background-position:center;
      background-repeat:no-repeat;
      background-size:cover;
      }
      .cus_img_grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
      gap:40px;
      align-items:center;
      }
      .inner_content h2{
      margin:0;
      font-size:56px;
      letter-spacing:-2.5%;
      background: linear-gradient(90deg, #9333EA 0%, #2563EB 100%);
  -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
      }

      .inner_description * {
      margin:0;
      }

      .inner_description p{
      font-size:20px;
      color: rgba(0, 0, 0, 0.8);
          padding: 20px 0px;
      }

      .cus_btn {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:10px 24px;
      background: linear-gradient(90deg, #9333EA 0%, #2563EB 100%);
      color:#fff;
      font-size:16px;
      font-weight:600;
      letter-spacing:0.6px;
      text-decoration:none;
      }

      .happy_customer {
      margin:0;
      font-size:14px;
      color:rgba(0, 0, 0, 0.8);
      text-decoration:underline;
          padding-top: 16px;
      }

      .cus_reviews {
      max-width: 850px;
      margin-inline: auto;
      text-align: center;
  }

  .reviews_rating {
      display: flex;
      align-items: center;
      gap: 10px;
      justify-content: center;
          padding-top: 20px;
  }

  .review_col {
      margin-top: 45px;
      border-top: 1px solid rgba(0, 0, 0, 0.5);
  }


  .reviews_content p {
      font-size: 22px;
      font-weight: 600;
      letter-spacing: 0.6px;
      line-height: normal;
          padding-top: 34px;
          color: rgba(0, 0, 0, 1);

  }

  .reviews_rating p {
    font-size: 14px;
    color: rgba(0, 0, 0, 0.8);
    letter-spacing:0.6px;

}
.reviews_date {
font-size:12px;
letter-spacing:0.6px;
 color: rgba(0, 0, 0, 0.8);
}

@media(max-width:550px){

}
</style>

{% schema %}
{
  "name": "Custom Image Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_img",
      "label": "Backgroud Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "inner_rich",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Button Url"
    },
    {
      "type": "text",
      "id": "happy_customer",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "Select Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "col",
      "name": "block",
      "settings": [
        {
          "type": "richtext",
          "id": "reviews_rich",
          "label": "Review Content"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Review Date"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image Text"
    }
  ]
}
{% endschema %}
