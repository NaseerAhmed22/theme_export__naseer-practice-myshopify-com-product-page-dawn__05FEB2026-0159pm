{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<style>
  .navbar {
    display: flex;
    gap: 40px;
  }
  .navbar ul {
    list-style-type: none;
    margin: 0;
    padding-bottom: 0;
    padding-inline: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 50px;
  }

  .navbar li {
    padding: 0;
    margin: 0;
  }

  .navbar li a {
    display: block;
    color: black;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    margin: 0;
    padding: 0;
  }

  .anchor-tag-cus {
    width: 100%;
    margin: auto;
  }

  .hats-content {
    display: none;
    position: absolute;
    background-color: #fff;
    max-width: 1400px;
    width: 100%;
    transform: translate(-50%, -50%);
    left: 50%;
    top: 285%;
    height: auto;
    margin-top: 2px;

    box-shadow: 0 0 15px #0000001a;
    z-index: 1;
    padding: 30px;
    transition: all 0.6s ease-in;
    border-radius: 30px;
   
  }

  .hats:hover .hats-content {
    display: flex;
    justify-content: space-between;
    gap: 15px;
  }
</style>

<nav class="header__inline-menu">
