        {% endfor %}

        {% comment %}
          {% for block in section.blocks %}
            {% if block.type == "image" %}
                <ul>
                  <li class="hats syco--color-{{ forloop.index }} ">
                    <a href="#">{{ block.settings.menuText }}</a>
                    {% if block.settings.text1 != blank %}
                      <div class="hats-content ">
                        <div class="syco-sub-menu ">
                          <div class="syco-main-title syco-grid syco-place-items-center syco-gap-1 syco-grid-cols-2">
                            <div class="syco-cus-img">
                              <img src="{{ block.settings.img1 | img_url: 'master' }}" alt="">
                            </div>
                            <div class="anchor-tag-cus">
