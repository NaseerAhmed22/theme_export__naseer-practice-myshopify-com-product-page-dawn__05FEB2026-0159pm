ot\">\n        <\/div>\n        \n        <div class=\"pricing-section\">\n            <p class=\"price-text\">\n                <span class=\"original-price\">$97<\/span> Only $12 Today\n            <\/p>\n            \n            <button class=\"cta-button\"  data-variant=\"{{ all_products['sample-product-1'].first_available_variant.id }}\">\n                <div class=\"lock-icon\"><\/div>\n                <span>SHOW ME THE NEW WAY!<br><small class=\"small-text\">one time payment of $12, lifetime access.<\/small><\/span>\n            <\/button>\n            \n            <div class=\"secure-payment\">\n                <div class=\"secure-payment-icon\"><\/div>\n                <span>Secure 256-bit SSL encrypted payment<\/span>\n            <\/div>\n        <\/div>\n        \n        <div class=\"bonus-section\">\n            <div class=\"bonus-text\">\n                You will also get 5 Bonuses<br>\n                Worth $449 for FREE\n            <\/div>\n            \n            <div class=\"divider\"><\/div>\n            \n            <div class=\"free-badges\">\n                <div class=\"free-badge\" style=\"background-image: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0682\/3202\/0061\/files\/The_New_Way_-_Sales_Page_2.jpg?v=1758125421');\"><\/div>\n                <div class=\"free-badge\" style=\"background-image: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0682\/3202\/0061\/files\/The_New_Way_-_Sales_Page_1.jpg?v=1758125421');\"><\/div>\n                <div class=\"free-badge\" style=\"background-image: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0682\/3202\/0061\/files\/The_New_Way_-_Sales_Page_4.jpg?v=1758125421');\"><\/div>\n                <div class=\"free-badge\" style=\"background-image: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0682\/3202\/0061\/files\/The_New_Way_-_Sales_Page_5.jpg?v=1758125421');\"><\/div>\n                <div class=\"free-badge\" style=\"background-image: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0682\/3202\/0061\/files\/The_New_Way_-_Sales_Page_3.jpg?v=1758125421');\"><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n<script>\n  function resetCTAButtons() {\n    document.querySelectorAll('.cta-button').forEach(button => {\n      button.classList.remove('loading');\n      button.style.setProperty('pointer-events', 'auto', 'important');\n      button.innerHTML = `\n        <div class=\"lock-icon\"><\/div>\n        <span>SHOW ME THE NEW WAY!<br>\n        <small class=\"small-text\">one time payment of $12, lifetime access.<\/small><\/span>\n      `;\n    });\n  }\n\n  \/\/ Reset buttons on normal page load\n  document.addEventListener('DOMContentLoaded', resetCTAButtons);\n\n  \/\/ Reset buttons when navigating back via bfcache\n  window.addEventListener('pageshow', function(event) {\n    if (event.persisted) {\n      resetCTAButtons();\n    }\n  });\n\n  \/\/ Check if product already exists in cart\n  async function isProductInCart(variantId) {\n    try {\n      const response = await fetch('\/cart.js');\n      const cart = await response.json();\n      return cart.items.some(item => item.variant_id == variantId);\n    } catch (error) {\n      console.error('Error checking cart:', error);\n      return false;\n    }\n  }\n\n  async function addToCartAndCheckout(button) {\n    const variantId = button.getAttribute('data-variant');\n\n    \/\/ Check if already in cart\n    const exists = await isProductInCart(variantId);\n    if (exists) {\n      alert('This product is already in your cart.');\n      return;\n    }\n\n    \/\/ Add loading state\n    button.classList.add('loading');\n    button.style.setProperty('pointer-events', 'none', 'important');\n    button.innerHTML = `\n      <div class=\"lock-icon\"><\/div>\n      <span style=\"text-decoration:none; background:none; border:none; outline:none; box-shadow:none !important;\">\n        PROCESSING\n      <\/span>\n    `;\n\n    \/\/ Add product to cart then redirect to checkout\n    fetch('\/cart\/add.js', {\n  