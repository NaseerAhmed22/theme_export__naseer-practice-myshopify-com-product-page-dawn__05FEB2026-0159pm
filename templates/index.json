.some(item => item.variant_id == variantId);\n    } catch (error) {\n      console.error('Error checking cart:', error);\n      return false;\n    }\n  }\n\n  async function addToCartAndCheckout(button) {\n    const variantId = button.getAttribute('data-variant');\n\n    \/\/ Check if already in cart\n    const exists = await isProductInCart(variantId);\n    if (exists) {\n      alert('This product is already in your cart.');\n      return;\n    }\n\n    \/\/ Add loading state\n    button.classList.add('loading');\n    button.style.setProperty('pointer-events', 'none', 'important');\n    button.innerHTML = `\n      <div class=\"lock-icon\"><\/div>\n      <span style=\"text-decoration:none; background:none; border:none; outline:none; box-shadow:none !important;\">\n        PROCESSING\n      <\/span>\n    `;\n\n    \/\/ Add product to cart then redirect to checkout\n    fetch('\/cart\/add.js', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application\/json' },\n      body: JSON.stringify({ id: variantId, quantity: 1 })\n    })\n    .then(() => {\n      window.location.href = '\/checkout';\n    })\n    .catch(err => {\n      console.error('Error adding to cart:', err);\n      resetCTAButtons();\n      alert('Something went wrong. Please try again.');\n    });\n  }\n\n  document.querySelectorAll('.cta-button').forEach(btn => {\n    btn.addEventListener('click', function(e) {\n      e.preventDefault();\n      addToCartAndCheckout(this);\n    });\n  });\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}},"multirow_CnjMXW":{"type":"multirow","blocks":{"row_NaA6VQ":{"type":"row","settings":{"caption":"Caption","heading":"Row","text":"<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.<\/p>","button_label":"Button label","button_link":""}},"row_HPHqPP":{"type":"row","settings":{"caption":"Caption","heading":"Row","text":"<p>Pair text with an image t