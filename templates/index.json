-shrink: 0;\n            margin: 0 5.76px;\n        }\n\n        .free-badges {\n            display: flex;\n            flex-wrap: nowrap;\n            justify-content: flex-start;\n            align-items: center;\n            overflow: visible;\n        }\n\n        .free-badge {\n            display: block;\n            width: 72px;\n            height: 48px;\n            background-size: contain;\n            background-repeat: no-repeat;\n            background-position: center;\n            transform: scale(1.828);\n            z-index: 1;\n            flex-shrink: 0;\n            margin-right: 16px;\n        }\n\n        .free-badge:last-child {\n            margin-right: 0;\n        }\n\n        .free-badge:not(:first-child) {\n            margin-left: 0;\n        }\n\n        .free-badge:hover {\n            z-index: 10;\n        }\n\n        \/* Responsive Design *\/\n        @media (max-width: 768px) {\n            .landing-section {\n                padding: 3px 3px 20px 3px; \/* 20px bottom padding in mobile *\/\n            }\n            \n            .main-headline {\n                font-size: 27.36px;\n            }\n            \n            .price-text {\n                font-size: 28.9px;\n            }\n            \n            .cta-button {\n                font-size: 21px;\n                padding: 18px 35px;\n            }\n            \n            .cta-button .small-text {\n                font-size: 15px !important;\n            }\n            \n            .sub-headline {\n                font-size: 20px;\n            }\n            \n            .intro-text {\n                font-size: 12px;\n                padding: 10px 15px;\n                max-width: 320px;\n            }\n\n            .secure-payment {\n                font-size: 13.24px;\n            }\n\n            .secure-payment-icon {\n                width: 23.59px;\n                height: 23.59px;\n            }\n\n            .bonus-section {\n                gap: 3p