      .free-badge {\n                width: 47.5px;\n                height: 33.25px;\n                flex-shrink: 0;\n            }\n        }\n\n    <\/style>\n\n  <div class=\"landing-section\">\n        <div class=\"intro-text\">\n            <div class=\"pulse-dot\"><\/div>\n            <span>75,000+ Students | 98.7% Satisfaction rate<\/span>\n        <\/div>\n        \n        <h1 class=\"main-headline\">\n            The New <span class=\"italic\">(and proven)<\/span> Way to Take Any eCommerce Store to <span class=\"highlight\">$10K Days<\/span> - in Under 30 Days\n        <\/h1>\n        \n        <p class=\"sub-headline\">\n            (With Ultra-High ROAS of 20+)\n        <\/p>\n        \n        <div class=\"screenshot-container\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0682\/3202\/0061\/files\/41.jpg?v=1758114302\" alt=\"Analytics Dashboard\" class=\"screenshot\">\n        <\/div>\n        \n        <div class=\"pricing-section\">\n            <p class=\"price-text\">\n                <span class=\"original-price\">$97<\/span> Only $12 Today\n            <\/p>\n            \n            <button class=\"cta-button\"  data-variant=\"{{ all_products['sample-product-1'].first_available_variant.id }}\">\n                <div class=\"lock-icon\"><\/div>\n                <span>SHOW ME THE NEW WAY!<br><small class=\"small-text\">one time payment of $12, lifetime access.<\/small><\/span>\n            <\/button>\n            \n            <div class=\"secure-payment\">\n                <div class=\"secure-payment-icon\"><\/div>\n                <span>Secure 256-bit SSL encrypted payment<\/span>\n            <\/div>\n        <\/div>\n        \n        <div class=\"bonus-section\">\n            <div class=\"bonus-text\">\n                You will also get 5 Bonuses<br>\n                Worth $449 for FREE\n            <\/div>\n            \n            <div class=\"divider\"><\/div>\n            \n            <div class=\"free-badges\">\n 